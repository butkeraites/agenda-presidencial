# Copie para .env e preencha os valores. O arquivo .env não é commitado.

# === Banco de dados (obrigatório) ===
POSTGRES_PASSWORD=changeme

# === Pipeline (opcional) ===
# Intervalo entre ciclos de scrape, em horas. Default: 24.
AGENDA_SCRAPE_INTERVAL_HOURS=24
# Retenção dos snapshots locais (.sql.gz em data/backups/), em dias. 0 = manter tudo.
AGENDA_SNAPSHOT_RETENTION_DAYS=30

# === Dashboard (opcional) ===
# Porta no host. Acesse no navegador em http://localhost:${DASHBOARD_PORT}
DASHBOARD_PORT=8050
GUNICORN_WORKERS=2

# === Backup off-host via git push (opcional — deixe em branco para pular) ===
# GIT_REMOTE no formato github.com/usuario/repo.git (sem https://, sem usuário).
GIT_REMOTE=
# Personal Access Token com permissão de push no repo.
GIT_TOKEN=
GIT_BRANCH=master
GIT_USER_EMAIL=agenda-bot@local
GIT_USER_NAME=agenda-bot
